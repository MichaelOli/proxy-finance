# === ROOT PATH ===
ROOT_PATH=/api/v1/proxy-finance
HTTP_PORT=8000

# === IDENTIFICACAO DE BANCO ===
# Threshold de bits para comparacao de perceptual hash de logos (0=identico)
LOGO_HASH_THRESHOLD=10
# Caminho para os binarios do Poppler (identificacao por logo).
# Linux/macOS: deixe vazio (poppler instalado via apt/brew ja esta no PATH).
# Windows: aponte para a pasta bin do poppler extraido.
# Download: https://github.com/oschwartz10612/poppler-windows/releases
POPPLER_PATH=

# === AUTENTICACAO ===
# false = desabilita autenticacao (desenvolvimento); true = exige API Key
API_KEY_ENABLED=false
# Chave de API para autenticacao (quando API_KEY_ENABLED=true)
API_KEY=sua-api-key-aqui
